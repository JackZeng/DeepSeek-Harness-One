# Web control plane
DSH_ONE_HOST=127.0.0.1
DSH_ONE_PORT=3210
DSH_ONE_DATA_DIR=~/.dsh-one
DSH_ONE_OPEN_BROWSER=true

# Official DeepSeek Harness launcher
DSH_ONE_DSH_COMMAND=dsh
DSH_ONE_DSH_PROFILE=headless
DSH_HOME=~/.dsh

# Runtime behavior
DSH_ONE_DEMO=false
DSH_ONE_CONCURRENCY=2
DSH_ONE_DEFAULT_MODE=auto
DSH_ONE_ALLOW_EXTENSION_INSTALL=false
DSH_ONE_PROOF_STRICT=true
